import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import mean_squared_error, mean_absolute_error
from tensorflow import keras
from tensorflow.keras import layers

# 1. Load NIFTY-50 dataset (columns typically include Date, Open, High, Low, Close, Volume)
df = pd.read_csv("NIFTY50.csv")
data = df[['Close']].values

# 2. Scale data
scaler = MinMaxScaler(feature_range=(0,1))
scaled_data = scaler.fit_transform(data)

# 3. Create sequences
window = 60
X, y = [], []
for i in range(window, len(scaled_data)):
    X.append(scaled_data[i-window:i, 0])
    y.append(scaled_data[i, 0])
X, y = np.array(X), np.array(y)
X = X.reshape(X.shape[0], X.shape[1], 1)

# 4. Train-test split (time-ordered)
split = int(len(X) * 0.8)
X_train, X_test = X[:split], X[split:]
y_train, y_test = y[:split], y[split:]

# 5. Build LSTM model
model = keras.Sequential([
    layers.LSTM(50, return_sequences=True, input_shape=(window,1)),
    layers.LSTM(50),
    layers.Dense(25, activation='relu'),
    layers.Dense(1)
])
model.compile(optimizer='adam', loss='mean_squared_error')
model.fit(X_train, y_train, epochs=20, batch_size=32, validation_split=0.1)

# 6. Predict and inverse-transform
predictions = model.predict(X_test)
predictions = scaler.inverse_transform(predictions)
actual = scaler.inverse_transform(y_test.reshape(-1,1))

rmse = np.sqrt(mean_squared_error(actual, predictions))
mae = mean_absolute_error(actual, predictions)
print("RMSE:", rmse)
print("MAE:", mae)

# 7. Plot
plt.figure(figsize=(12,6))
plt.plot(actual, label='Actual Close Price')
plt.plot(predictions, label='Predicted Close Price')
plt.title("NIFTY-50 Closing Price Forecast")
plt.xlabel("Time")
plt.ylabel("Price")
plt.legend()
plt.show()
